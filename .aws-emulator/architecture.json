{
  "schemaVersion": 1,
  "name": "checkout-review-demo",
  "description": "Synthetic checkout with an added fulfillment queue, no existing resources changed.",
  "actor": {
    "id": "CheckoutApp",
    "label": "Checkout API"
  },
  "resources": [
    {
      "id": "ReceiptBucket",
      "type": "s3-bucket",
      "label": "Receipt storage"
    },
    {
      "id": "OrdersTable",
      "type": "dynamodb-table",
      "label": "Order records",
      "partitionKey": "orderId"
    },
    {
      "id": "FulfillmentQueue",
      "type": "sqs-queue",
      "label": "Fulfillment events"
    }
  ],
  "flows": [
    {
      "from": "CheckoutApp",
      "to": "ReceiptBucket",
      "label": "Save receipt"
    },
    {
      "from": "CheckoutApp",
      "to": "OrdersTable",
      "label": "Save order"
    },
    {
      "from": "CheckoutApp",
      "to": "FulfillmentQueue",
      "label": "Publish event"
    }
  ]
}
